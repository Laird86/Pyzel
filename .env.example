# Pyzel example environment file
# Copy this file to .env locally and replace the example values.
# Never commit real credentials.

ZELLO_USERNAME=example-user
ZELLO_PASSWORD=example-password
ZELLO_CHANNEL=ExampleChannel
ZELLO_ENDPOINT=wss://zello.io/ws

# Optional token-based auth examples. Leave blank unless you use these flows.
ZELLO_AUTH_TOKEN=
ZELLO_REFRESH_TOKEN=
